# 복사해서 .env로 쓴다. 값이 없으면 개발 기본값(fake 모델, fake 백엔드, 메모리 상태)으로 돈다.
# 자주 바꾸는 것의 설명: README.md "환경변수". 전체 목록과 기본값: app/settings/sections.py

APP_CORS_ORIGINS=http://localhost:5173
ROOM_TICKET_SECRET=dev-room-ticket-secret-change-me-32bytes!!
INTERNAL_API_KEY=dev-internal-key

# 백엔드: fake(단독 실행) | http
BACKEND_MODE=fake
BACKEND_BASE_URL=http://localhost:8080

# 방 상태·이벤트: memory(서버 한 대) | redis(여러 대)
STATE_STORE=memory
STATE_EVENT_BUS=memory
# STATE_REDIS_URL=redis://localhost:6379/0
# STATE_REDIS_SENTINELS=host1:26379,host2:26379
# STATE_REDIS_SENTINEL_MASTER=mymaster

# 음성 보관: 기본은 저장하지 않음
AUDIO_RETENTION=MEMORY_ONLY
AUDIO_STORE=memory

# 모델: config/providers.yaml 을 고치거나 아래처럼 덮어쓴다
# PROVIDERS__LLM__FAST__IMPL=openai_compatible
# PROVIDERS__LLM__FAST__MODEL=<사내 모델 이름>
# PROVIDERS__LLM__FAST__OPTIONS__BASE_URL=http://<llm-host>/v1
# LLM_API_KEY=
# PROVIDERS__STT__LIVE__IMPL=whisper_http
# PROVIDERS__STT__LIVE__MODEL=whisper-large-v3
# PROVIDERS__STT__LIVE__OPTIONS__BASE_URL=http://<ds-api-hub-host>
# STT_API_KEY=
